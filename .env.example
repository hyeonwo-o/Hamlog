NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Switch only after /admin and /admin/* are protected by the same owner-only Access app.
AUTH_MODE=password
CLOUDFLARE_ACCESS_TEAM_DOMAIN=techhamwoo.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=10d251866cbee316730109479c55015a062851c97b14f5a7f14fa2eaf157d16b
# In cloudflare-access mode ADMIN_PASSWORD is unused; keep JWT_SECRET stable for analytics.
# Published host port; keep loopback when a reverse proxy runs on this host.
HAMLOG_BIND_ADDRESS=127.0.0.1
# Host group allowed to read bind-mounted data (use `id -g`; commonly 1000).
HAMLOG_DATA_GID=1000
# Optional: keep anonymous visitor hashes stable when JWT_SECRET is rotated.
ANALYTICS_SECRET=replace-with-a-separate-long-random-secret
ANALYTICS_TIME_ZONE=Asia/Seoul
CORS_ORIGINS=https://example.com
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
# Number of trusted reverse-proxy hops. Leave 0 when Express is directly exposed.
TRUST_PROXY=0
SITE_URL=https://example.com
